# Copy to .env and fill in. .env is gitignored: this is a public fork.

# The harness data to read, mounted read-only. Must be the home of the user whose uid is
# 1000 on this machine, since that is the uid the container runs as.
CLAUDE_HOME=/home/you/.claude

# Only needed when something proxies this server — a tunnel or a reverse proxy passes on the
# name the browser asked for, not the address it arrived at, and an unlisted name is refused.
# Comma-separated. Leave empty when reaching the port directly.
BOT_CROSSING_ALLOWED_HOSTS=
